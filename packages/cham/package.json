{
  "name": "@hanology/cham",
  "version": "0.1.14",
  "description": "Classical Han Annotated Markdown — parser, serializer, ePub converter, and validator",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./parser": {
      "import": "./dist/parser.js",
      "types": "./dist/parser.d.ts"
    },
    "./serializer": {
      "import": "./dist/serializer.js",
      "types": "./dist/serializer.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./pipeline": {
      "import": "./dist/pipeline.js",
      "types": "./dist/pipeline.d.ts"
    },
    "./yaml": {
      "import": "./dist/yaml.js",
      "types": "./dist/yaml.d.ts"
    }
  },
  "bin": {
    "cham-epub": "dist/cli.js",
    "cham-validate": "dist/cli-validate.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "fflate": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^6.0.0",
    "vitest": "^4.1.7"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanologyorg/cham-js",
    "directory": "packages/cham"
  },
  "publishConfig": {
    "access": "public"
  }
}
